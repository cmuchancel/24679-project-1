{
  "$schema": "sjs/1.0",
  "model_meta": {
    "system_name": "Trailing-offset disk brake",
    "system_id": "US7461725B2",
    "description": "Disk brake arrangement with opposed pads and a trailing circumferential offset between their centers of gravity.",
    "version": "1.0",
    "lifecycle_stage": "concept",
    "domain": "Vehicle braking",
    "maturity": "draft",
    "date_modified": "2026-09-27"
  },
