          "flow_ref": "F_CONTACT",
          "interface_type": "frictional_contact"
        },
        {
          "interface_id": "I_PAD2_CAL",
          "mating_subsystem": "CAL",
          "port_this": "P_PAD2_CAL",
          "port_mate": "P_CAL_PAD2",
          "flow_ref": "F_BRAKE",
          "interface_type": "mechanical_force_transfer"
        }
      ]
    },
    {
      "subsystem_id": "CAL",
      "subsystem_name": "Brake caliper",
