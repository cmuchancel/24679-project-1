          "interface_type": "frictional_contact"
        }
      ]
    },
    {
      "subsystem_id": "PAD2",
      "subsystem_name": "Second brake pad",
      "description": "Pad on the second side of the disk; its center of gravity is circumferentially offset toward the trailing side relative to the first pad center of gravity.",
