          "port_id": "P_DISK_PAD2",
          "name": "Second-side friction surface",
          "direction": "inout",
          "flow_type": "mechanical_contact"
        }
      ]
    },
    {
      "subsystem_id": "PAD1",
      "subsystem_name": "First brake pad",
