          "flow_ref": "F_CLAMP",
          "interface_type": "mechanical_force_transfer"
        }
      ]
    },
    {
      "subsystem_id": "BRACKET",
      "subsystem_name": "Bracket part",
      "description": "Plate-shaped bracket part supporting the caliper; disclosed as optionally integral with an axle part.",
      "domain": "Mechanical"
    },
    {
      "subsystem_id": "AXLE",
      "subsystem_name": "Axle part",
      "description": "Vehicle axle part to which the bracket/caliper support can be connected.",
