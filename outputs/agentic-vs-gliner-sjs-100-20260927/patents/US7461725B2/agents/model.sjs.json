    },
    {
      "subsystem_id": "VEHICLE",
      "subsystem_name": "Vehicle structure",
      "description": "External vehicle structure receiving brake support reaction loads.",
      "domain": "Mechanical"
    }
  ],
  "item_flows": [
    {
      "flow_id": "F_CLAMP",
      "name": "Clamping force",
      "flow_type": "mechanical_force",
      "notes": "Clamping device applies force to first pad along the disk-normal axis."
    },
    {
      "flow_id": "F_BRAKE",
      "name": "Braking force",
      "flow_type": "mechanical_force",
      "notes": "Braking force from second pad is transmitted by caliper to the first side of the disk."
    },
    {
      "flow_id": "F_CONTACT",
      "name": "Pad-disk frictional contact",
      "flow_type": "mechanical_contact",
      "notes": "Frictional engagement of each pad with its respective disk side."
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "A_APPLY",
        "name": "Apply first pad",
        "owner": "CLAMP",
        "steps": [
          {
            "step_no": 1,
            "description": "Push the first brake pad against the brake disk along the clamping-device center axis."
          }
        ]
      },
      {
        "action_id": "A_BRAKE_CONTACT",
        "name": "Engage opposed pads with disk",
        "owner": "CAL",
        "steps": [
          {
            "step_no": 1,
            "description": "The first and second brake pads frictionally engage their respective sides of the brake disk during braking."
          },
          {
            "step_no": 2,
            "description": "The caliper transmits braking forces produced by the second pad to the first side of the disk."
          }
        ]
      }
    ]
  }
