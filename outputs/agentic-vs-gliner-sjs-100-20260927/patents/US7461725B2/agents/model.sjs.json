          "direction": "out",
          "flow_type": "mechanical_force"
        },
        {
          "port_id": "P_PAD2_CONTACT",
          "name": "Second pad-disk friction contact",
          "direction": "inout",
          "flow_type": "mechanical_contact"
        }
      ],
      "interfaces": [
