{
  "$schema": "sjs/1.0",
  "model_meta": {
    "system_name": "Robust Over-Center Latch Assembly",
    "system_id": "US8240724B2",
    "description": "Inferred physical model of the latch assembly coupling two relatively movable unit parts through a hinged handle, pivot, hasp and mating hook, with rotation stop and hinge bearing. Manual/user-applied force or rotation at the handle is an external initiating input outside the modeled latch-assembly boundary; no actuator or user interface is modeled.",
    "version": "1.0",
    "lifecycle_stage": "concept",
    "domain": "Mechanical latching",
    "maturity": "draft",
    "date_modified": "2026-09-27"
  },
