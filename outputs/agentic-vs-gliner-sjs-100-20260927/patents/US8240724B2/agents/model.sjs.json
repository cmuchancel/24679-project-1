  "item_flows": [
    {
      "flow_id": "motion_handle",
      "name": "Handle rotation",
      "flow_type": "mechanical_rotary",
      "notes": "Handle rotation is transmitted through the hinge and pivot; the pivot traverses about the hinge."
    },
    {
      "flow_id": "mechanical_coupling",
      "name": "Latch coupling load",
      "flow_type": "mechanical_force",
      "notes": "Over-center linkage and engaged hasp/hook couple the first and second parts."
    },
    {
      "flow_id": "stop_contact",
      "name": "Stop contact reaction",
      "flow_type": "mechanical_contact",
      "notes": "Mechanical contact at the base-coupled stop surface limits handle rotation."
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "act_latch",
        "name": "Latch and secure movable parts",
        "owner": "HANDLE",
        "steps": [
          {
            "step_no": 1,
            "description": "Manually rotate the handle toward its minimum arc; the pivot traverses about the hinge and the hasp engages the hook."
          },
          {
            "step_no": 2,
            "description": "As the handle reaches the stop surface, handle rotation is limited; the described reaction urges the handle against the stop."
          }
        ]
      },
      {
        "action_id": "act_unlatch",
        "name": "Unlatch movable parts",
        "owner": "HANDLE",
        "steps": [
          {
            "step_no": 1,
            "description": "Rotate the handle to move the hasp until it decouples from the hook."
          },
          {
            "step_no": 2,
            "description": "With the hasp disengaged, move the first part relative to the second part."
          }
        ]
      }
    ]
  }
