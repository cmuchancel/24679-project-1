  "behaviour": {
    "actions": [
      {
        "action_id": "A_CLAMP",
        "name": "Clamp tool shank",
        "owner": "COLLET",
        "steps": [
          {
            "step_no": 1,
            "description": "Clamping nut advances the pressure piece and collet axially into the receiver opening."
          },
          {
            "step_no": 2,
            "description": "Conical contact between collet and receiver produces inward radial compression of the collet."
          },
          {
            "step_no": 3,
            "description": "Collet compression clamps the tool shank in the collet bore."
          }
        ]
      },
      {
        "action_id": "A_KEY",
        "name": "Resist relative rotation",
        "owner": "PRESSURE",
        "steps": [
          {
            "step_no": 1,
            "description": "Pressure-piece coupling elements engage mating elements of the tool receiving element to prevent relative rotation; their angular position corresponds to the receiver detent features."
          },
          {
            "step_no": 2,
            "description": "The pressure piece and collet are detachably coupled torsion-proof at a predefined relative angle; collet detent lugs engage receiver detent grooves by relative rotation, with the detent and coupling features positioned at the same respective angular relationship."
          }
        ]
      }
    ]
