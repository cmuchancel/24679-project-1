        "action_id": "lift_frames",
        "name": "Lift frames through lever-driven scissor motion",
        "owner": "scissor_mechanism",
        "steps": [
          {
            "step_no": 1,
            "description": "Linear actuator applies force to the lever arm gearing."
          },
          {
            "step_no": 2,
            "description": "Lever arm pivots about its joint with the scissor mechanism and transmits force to the scissor mechanism."
          },
