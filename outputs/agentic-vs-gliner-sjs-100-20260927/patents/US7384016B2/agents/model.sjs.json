          "interface_type": "mechanical attachment"
        }
      ]
    },
    {
      "subsystem_id": "SUPPORT",
      "subsystem_name": "Support Element",
      "description": "External supporting structure; a claimed example is an aircraft wing spar.",
      "domain": "host structure",
      "ports": [
        {
          "port_id": "SUPPORT_FRAME",
          "name": "Frame coupler attachment",
          "direction": "inout",
          "flow_type": "mechanical_linear"
        }
      ]
    },
    {
      "subsystem_id": "SURFACE",
      "subsystem_name": "Compliant Surface",
