          "interface_type": "mechanical force application"
        },
        {
          "interface_id": "FRAME_LINK_FIRST",
          "mating_subsystem": "LINK",
          "port_this": "FRAME_LINK_1",
          "port_mate": "LINK_END_1",
          "flow_ref": "LINKAGE_COUPLING",
          "interface_type": "resilient mechanical coupling"
        },
        {
          "interface_id": "FRAME_LINK_SECOND",
          "mating_subsystem": "LINK",
          "port_this": "FRAME_LINK_2",
