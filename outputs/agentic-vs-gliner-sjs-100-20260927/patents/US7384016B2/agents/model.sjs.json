          "port_this": "FRAME_SURFACE",
          "port_mate": "SURFACE_FRAME",
          "flow_ref": "CONTOUR",
          "interface_type": "contour communication"
        }
      ]
    },
    {
      "subsystem_id": "LINK",
      "subsystem_name": "Resilient Linkage",
      "description": "One or more resilient linkage elements couple the inner surfaces of the first and second frame elements; disclosed examples may be elongated and parallel.",
