  ],
  "item_flows": [
    {
      "flow_id": "FORCE",
      "name": "Actuator force",
      "flow_type": "mechanical_linear",
      "notes": "Force applied to the second frame element with respect to support."
    },
    {
      "flow_id": "CONTOUR",
      "name": "Surface contour variation",
      "flow_type": "mechanical_deformation",
      "notes": "Corresponding contour change at compliant surface."
    },
    {
      "flow_id": "LINKAGE_COUPLING",
      "name": "Resilient linkage coupling",
      "flow_type": "mechanical_deformation",
      "notes": "Structural/deformation coupling between linkage ends and the frame inner surfaces."
    },
    {
      "flow_id": "STRUCTURAL_ATTACHMENT",
      "name": "Frame-support structural attachment",
      "flow_type": "mechanical_linear",
      "notes": "Structural attachment relationship through the frame coupler between the frame and support; distinct from actuator force."
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "CHANGE_CONTOUR",
        "name": "Change compliant surface contour",
        "owner": "ACT",
        "steps": [
          {
            "step_no": 1,
            "description": "Actuator applies force to the second resiliently variable frame element relative to the support element."
          },
          {
            "step_no": 2,
            "description": "Frame deformation is transmitted through its resiliently coupled elements, varying the frame outer surface contour."
          },
          {
            "step_no": 3,
            "description": "The communicating compliant surface assumes a corresponding contour variation."
          }
        ]
      }
    ]
  }
