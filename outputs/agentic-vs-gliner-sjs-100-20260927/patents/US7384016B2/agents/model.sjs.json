{
  "$schema": "sjs/1.0",
  "model_meta": {
    "system_name": "Adaptive Compliant Surface Contour Mechanism",
    "system_id": "US7384016B2",
    "description": "Concept model of a compliant frame mechanism that changes compliant surface contour by actuating a resiliently linked frame element relative to a support.",
    "version": "1.0",
    "lifecycle_stage": "concept",
    "domain": "Adaptive compliant wing and rotor systems",
    "maturity": "draft",
    "date_modified": "2026-09-27"
  },
  "subsystems": [
    {
      "subsystem_id": "FRAME",
      "subsystem_name": "Compliant Frame",
      "description": "First and second resiliently variable frame elements with respective inner and outer surfaces arranged in distal opposition. In this claim-1 model, the first outer surface communicates with the compliant surface; the second outer-surface relationship is not modeled as coupled to a compliant surface.",
      "domain": "compliant structure",
      "functional_basis": [
        "vary surface contour"
      ],
      "ports": [
        {
          "port_id": "FRAME_FORCE_IN",
          "name": "Force application at second frame element",
          "direction": "in",
          "flow_type": "mechanical_linear"
        },
        {
          "port_id": "FRAME_LINK_1",
          "name": "First inner-surface linkage attachment",
          "direction": "inout",
          "flow_type": "mechanical_deformation"
        },
        {
          "port_id": "FRAME_LINK_2",
          "name": "Second inner-surface linkage attachment",
          "direction": "inout",
          "flow_type": "mechanical_deformation"
        },
        {
          "port_id": "FRAME_SUPPORT",
          "name": "First frame element support attachment",
          "direction": "inout",
          "flow_type": "mechanical_linear"
        },
        {
          "port_id": "FRAME_CONTOUR_OUT",
          "name": "First outer-surface contour response",
          "direction": "out",
          "flow_type": "mechanical_deformation"
        },
        {
          "port_id": "FRAME_SURFACE",
