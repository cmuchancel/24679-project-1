    },
    {
      "flow_id": "shaft_load",
      "name": "Rocking-member shaft reaction load",
      "flow_type": "mechanical_force",
      "notes": "Load passes through shaft ends and support members to case."
    },
    {
      "flow_id": "spring_bias",
      "name": "Spring bias force",
      "flow_type": "mechanical_force",
      "notes": "Biasing means tends to rotate the rocking member about the shaft axis, causing it to press one belt span and establish initial tension."
    }
  ],
  "requirements": [
    {
      "req_id": "REQ_SUPPORT",
      "category": "structural",
      "priority": "claim",
      "statement": "Hold both shaft ends through respective support members covering at least the side surfaces of the corresponding ends.",
      "rationale": "Claim 1; disperses concentrated load and suppresses stress at second-member holding locations.",
      "satisfied_by": [
        "ROT2",
        "SHAFT",
        "BUSH"
      ]
    },
    {
      "req_id": "REQ_ONEWAY",
      "category": "function",
      "priority": "claim",
      "statement": "Provide one-way torque transmission using the friction member looped between the first-member and rocking-member working surfaces.",
      "rationale": "Claim 1 identifies one-way clutch structure and friction member arrangement.",
      "satisfied_by": [
        "ROT1",
        "BELT",
        "ROCK"
      ]
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "ACT_BIAS",
        "name": "Bias belt span",
        "owner": "SPRING",
        "steps": [
          {
            "step_no": 1,
            "description": "Apply bias tending to rotate the rocking member about the shaft axis."
          },
          {
            "step_no": 2,
            "description": "Rocking member presses one belt span to establish initial tension."
          }
        ]
      },
      {
        "action_id": "ACT_TRANSFER",
        "name": "Transmit or block torque",
        "owner": "BELT",
        "steps": [
          {
            "step_no": 1,
            "description": "Torque input changes belt tension and loads the rocking member."
          },
          {
            "step_no": 2,
            "description": "Belt friction transmits torque in the transmitting direction; in the blocking direction the belt slides at the first member working surface."
          },
          {
            "step_no": 3,
            "description": "Rocking-member load passes through shaft ends and support members into the case, distributing load at the supports."
          }
        ]
      }
    ]
  }
