  "item_flows": [
    {
      "flow_id": "BELT_TORQUE",
      "name": "Belt torque",
      "flow_type": "mechanical_rotational",
      "notes": "Engine crankshaft torque is conveyed through the belt to the outer ring pulley."
    },
    {
      "flow_id": "CLUTCH_TORQUE",
      "name": "Inter-ring torque",
      "flow_type": "mechanical_rotational",
      "notes": "Cam members transmit torque when wedged in locking direction and block it in unlocking direction."
    },
    {
      "flow_id": "CAGE_COUPLED_MOTION",
      "name": "Unitary coupled cage rotation",
      "flow_type": "mechanical_rotational",
      "notes": "The bearing cage rotates in the same direction as outer-ring relative rotation at lower relative speed, and its unitary connection carries the clutch cage in that motion."
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "TRANSFER_OR_BLOCK_TORQUE",
        "name": "Transfer or block inter-ring torque",
        "owner": "ONE_WAY_CLUTCH",
        "steps": [
          {
            "step_no": 1,
            "description": "Relative rotation in the locking direction tilts cam members toward wedging between inner and outer rings, transmitting torque."
          },
          {
            "step_no": 2,
            "description": "Relative rotation in the unlocking direction tilts cam members opposite the wedging direction, blocking torque transmission."
          }
        ]
      },
      {
        "action_id": "REDUCE_SPRAG_SLIDING",
        "name": "Reduce concentrated cam sliding during idling",
        "owner": "ONE_WAY_CLUTCH",
        "steps": [
          {
            "step_no": 1,
            "description": "Rolling elements rotate the bearing cage at lower relative speed than the outer ring."
          },
          {
            "step_no": 2,
            "description": "The coupled clutch cage carries the cam members at reduced bodily speed; during idling they slide on both rings and inner-ring sliding speed is lowered."
          }
        ]
      }
    ]
  }
