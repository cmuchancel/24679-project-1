        "name": "Guide moving feed rod",
        "owner": "GUIDE",
        "steps": [
          {
            "step_no": 1,
            "description": "Support the moving feed rod on spaced bushes and guide it toward the working machine."
          }
        ]
      },
      {
        "action_id": "A_DISTRIBUTE",
        "name": "Distribute fluid between reservoirs",
        "owner": "FLUID",
        "steps": [
