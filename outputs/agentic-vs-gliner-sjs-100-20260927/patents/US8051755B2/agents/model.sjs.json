          {
            "step_no": 2,
            "description": "Allow fluid to flow between neighboring reservoirs through the path formed at the support-guide and elastic-material contact surfaces."
          }
        ]
      },
      {
        "action_id": "A_ATTENUATE",
        "name": "Attenuate feed-rod vibration",
        "owner": "ELASTIC",
        "steps": [
