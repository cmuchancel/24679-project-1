  "item_flows": [
    {
      "flow_id": "ROTATION",
      "name": "Lid/shaft pivot rotation",
      "flow_type": "mechanical_rotational",
      "notes": "Opening or closing rotation about the hinge axis is transmitted between lid and shaft; relative rotation occurs between shaft and body/base."
    },
    {
      "flow_id": "TORQUE",
      "name": "Hinge torque",
      "flow_type": "mechanical_rotational",
      "notes": "Spring torsion assists or opposes lid movement; friction resists relative rotation. Transformation/storage occurs within hinge components."
    }
