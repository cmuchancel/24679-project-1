  "behaviour": {
    "actions": [
      {
        "action_id": "PIVOT",
        "name": "Pivot lid relative to base",
        "owner": "SHAFT",
        "steps": [
          {
            "step_no": 1,
            "description": "Lid rotation drives the shaft through the lid-shaft engagement."
          },
          {
            "step_no": 2,
            "description": "Shaft and spring major portion rotate while the spring angled portion and fixation member remain substantially stationary relative to the body, torsionally loading the spring."
          },
          {
            "step_no": 3,
            "description": "Friction member resists shaft rotation relative to the body; spring torque assists or opposes movement."
          }
        ]
      }
    ]
