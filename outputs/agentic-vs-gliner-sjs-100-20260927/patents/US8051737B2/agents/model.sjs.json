  "requirements": [
    {
      "req_id": "REQ_AXIAL_LIMIT",
      "category": "functional",
      "priority": "high",
      "statement": "The first and second thrust bearings contact respective shaft ends to limit axial movement of the shaft.",
      "rationale": "Claim 1 expressly assigns axial movement limitation to the pair of thrust bearings.",
      "satisfied_by": [
        "thrust_bearing_1",
        "thrust_bearing_2"
      ]
    },
    {
      "req_id": "REQ_OFFSET_CONTACT",
      "category": "structural",
      "priority": "high",
      "statement": "The first thrust-bearing face has a recess opening smaller than the shaft diameter, and the convexly rounded first shaft end contacts the face at the recess edge at locations removed from the shaft axis.",
      "rationale": "Independent claim 1; claim 10 further describes a circular contact line.",
      "satisfied_by": [
        "thrust_bearing_1",
        "shaft_worm"
      ]
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "ACT_TRANSMIT_ROTATION",
        "name": "Transmit rotation through worm gearing",
        "owner": "worm_wheel",
        "steps": [
          {
            "step_no": 1,
            "description": "The shaft-mounted worm rotates with the shaft and meshes with the worm wheel."
          },
          {
            "step_no": 2,
            "description": "The worm drives the worm wheel, which drives the associated output."
          }
        ]
      },
      {
        "action_id": "ACT_RESTRAIN_AXIAL_SHAFT",
        "name": "Restrain shaft axial movement at thrust faces",
        "owner": "thrust_bearing_1",
        "steps": [
          {
            "step_no": 1,
            "description": "Background operating context: reaction forces associated with the worm and worm wheel may load a respective shaft end against a thrust bearing; this is not asserted as a defining operation of the claimed arrangement."
          },
          {
            "step_no": 2,
            "description": "The thrust-bearing faces contact the shaft ends and limit axial movement; at the first bearing, the rounded shaft end contacts the recessed face edge away from the axis."
          }
        ]
      }
    ]
  }
