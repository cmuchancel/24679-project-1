  "requirements": [
    {
      "req_id": "REQ_PROGRESSION",
      "category": "performance",
      "priority": "claimed",
      "statement": "Provide a progression ratio of approximately 24% to 69% when ATV frame height above ground is between 1.5 and 12.0 inches.",
      "rationale": "Claim 1 specifies this range and interval; claims 5 and 20 define the ratio from leverage ratios at the interval endpoints.",
      "satisfied_by": [
        "LINK1",
        "LINK2"
      ]
    }
