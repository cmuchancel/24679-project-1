  "behaviour": {
    "actions": [
      {
        "action_id": "ACT_PROGRESS",
        "name": "Vary leverage through wheel travel",
        "owner": "LINKAGE",
        "steps": [
          {
            "step_no": 1,
            "description": "As the rear suspension moves through travel, the frame and suspension-arm mounting points move closer together or farther apart."
          },
          {
            "step_no": 2,
            "description": "The connected links move through the resulting linkage motion, changing leverage ratio and producing faster shock shaft travel during up travel."
          }
        ]
      }
    ]
  }
