            "step_no": 1,
            "description": "Fix the volute springs by sandwiching them between the side plate and the axial end face of the one-way clutch."
          }
        ]
      },
      {
        "action_id": "transmit_torque",
        "name": "Transmit torque between races",
        "owner": "engaging_members",
        "steps": [
          {
            "step_no": 1,
            "description": "Transmit torque between the outer race and inner race through the engaging members arranged between them."
          }
        ]
      },
      {
        "action_id": "retain_springs_circumferentially",
        "name": "Retain volute springs circumferentially",
        "owner": "cage",
        "steps": [
          {
            "step_no": 1,
            "description": "Retain each volute spring by sandwiching it between the outer-race convex inward projection and the outer circumferential face of the cage cylindrical portion."
