  "interfaces": [],
  "behaviour": {
    "actions": [
      {
        "action_id": "apply_primary_brake",
        "name": "Apply primary hydraulic braking",
        "owner": "PRIMARY_HYDRAULIC",
        "steps": [
          {
            "step_no": 1,
            "description": "Hydraulic control supplies fluid pressure through the actuator port to the headside chamber."
          },
          {
            "step_no": 2,
            "description": "Piston advances and transmits thrust through the thrust collar to the active friction element, engaging it with the disc."
          }
        ]
      },
      {
        "action_id": "apply_parking_brake",
        "name": "Apply secondary parking brake",
        "owner": "SECONDARY_LEVER",
        "steps": [
          {
            "step_no": 1,
            "description": "Lever pivots about its support and delivers thrust independently to the active friction element."
          },
          {
            "step_no": 2,
            "description": "Axial sliding of the disc causes engagement with the opposite friction element against the fixed support."
          }
        ]
      }
    ]
  },
