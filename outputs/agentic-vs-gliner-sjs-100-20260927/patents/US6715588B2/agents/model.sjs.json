      "description": "Rotatable disc and its axially fixed rotatable mounting form a journalled assembly; drive-dogs and corresponding grooves permit the disc to slide axially relative to the mounting while rotating.",
      "domain": "Mechanical",
      "ports": [
        {
          "port_id": "disc_active_face",
          "name": "Active-side friction interface",
          "direction": "inout",
          "flow_type": "mechanical_contact"
        },
        {
          "port_id": "disc_passive_face",
          "name": "Opposite-side friction interface",
          "direction": "inout",
          "flow_type": "mechanical_contact"
        },
        {
          "port_id": "disc_axial_motion",
          "name": "Axial displacement output during secondary braking",
          "direction": "out",
          "flow_type": "mechanical_linear"
        },
        {
          "port_id": "disc_rotatable_mount",
          "name": "Rotatable mounting and drive-dog relationship",
          "direction": "inout",
          "flow_type": "mechanical_contact"
        }
      ],
      "interfaces": [
        {
          "interface_id": "disc_axial_motion_to_passive_pad",
