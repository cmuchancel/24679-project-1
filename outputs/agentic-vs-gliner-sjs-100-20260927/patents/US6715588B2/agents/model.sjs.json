    },
    {
      "flow_id": "PRIMARY_THRUST",
      "name": "Primary actuator thrust",
      "flow_type": "mechanical_force",
      "notes": "Piston thrust is delivered through thrust collar to active friction element."
    },
    {
      "flow_id": "PARKING_THRUST",
