{
  "$schema": "sjs/1.0",
  "model_meta": {
    "system_name": "Spot-Type Disc Brake with Parking Brake Function",
    "system_id": "US6715588B2",
    "description": "Inferred concept model of a spot-type automotive disc brake using primary hydraulic and independent secondary lever actuation of the same friction element, with an axially sliding disc and fixed caliper support.",
    "version": "1.0",
    "lifecycle_stage": "concept",
    "domain": "Automotive braking",
    "maturity": "draft",
    "date_modified": "2026-09-27"
  },
  "subsystems": [
