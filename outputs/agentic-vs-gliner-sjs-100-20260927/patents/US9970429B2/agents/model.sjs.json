  "behaviour": {
    "actions": [
      {
        "action_id": "pump_process",
        "name": "Pump process fluid",
        "owner": "diaphragm",
        "steps": [
          {
            "step_no": 1,
            "description": "When pumping-zone volume increases, process fluid enters through the inlet and inlet valve."
          },
          {
            "step_no": 2,
            "description": "When pumping-zone volume decreases, process fluid exits through the outlet valve into the outlet region."
          }
        ]
      },
      {
        "action_id": "bypass_return",
        "name": "Return fluid through bypass",
        "owner": "bypass",
        "steps": [
          {
            "step_no": 1,
            "description": "When bypass valve is open, process fluid flows from outlet region through the bypass into inlet region."
          }
        ]
      },
      {
        "action_id": "route_inlet_feed",
        "name": "Route supplied fluid through housing inlet region",
        "owner": "housing",
        "steps": [
          {
            "step_no": 1,
            "description": "Receive supplied process fluid at inlet_feed in the housing inlet region."
          },
          {
            "step_no": 2,
            "description": "Carry the fluid internally through the inlet region to pump_in, where it proceeds to the inlet valve and pumping zone."
          }
        ]
      }
    ]
