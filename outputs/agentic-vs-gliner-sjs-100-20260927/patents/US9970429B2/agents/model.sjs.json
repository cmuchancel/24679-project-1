  "item_flows": [
    {
      "flow_id": "feed",
      "name": "Process fluid feed",
      "flow_type": "hydraulic_fluid",
      "notes": "Process fluid travels from the external source through housing.inlet_feed into the housing inlet region; the housing's internal inlet-region route carries this same supplied fluid onward to housing.pump_in and the inlet valve."
    },
    {
      "flow_id": "pumpflow",
      "name": "Pumped process fluid",
      "flow_type": "hydraulic_fluid",
      "notes": "Fluid routed internally through the housing inlet region from inlet_feed to pump_in then passes through the inlet valve into the pumping zone; after diaphragm-driven pumping it passes through the outlet valve into the housing outlet region."
    },
    {
      "flow_id": "bypassflow",
      "name": "Bypass return fluid",
      "flow_type": "hydraulic_fluid",
      "notes": "When bypass valve is open, outlet region returns fluid to inlet region."
    },
    {
      "flow_id": "discharge",
      "name": "Discharged process fluid",
      "flow_type": "hydraulic_fluid",
      "notes": "Outlet region to external receiver."
    },
