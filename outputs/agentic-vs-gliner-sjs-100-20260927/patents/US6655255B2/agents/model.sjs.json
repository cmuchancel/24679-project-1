  "requirements": [
    {
      "req_id": "REQ_PIVOT_ORIENTATION",
      "category": "geometric constraint",
      "priority": "claim limitation",
      "statement": "The primary and secondary pivot directions are positioned at an angle about the rotating-group axis; dependent claims disclose 80–100 degrees and a 90-degree unidirectional embodiment.",
      "rationale": "Claims 3–5 and 18–19; describes claim-specific configurations rather than universal operating limits.",
      "satisfied_by": [
        "primary_swashplate",
        "secondary_swashplate"
      ]
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "ACT_PUMP_FLUID",
        "name": "Pump fluid through rotating group",
        "owner": "rotating_group",
        "steps": [
          {
            "step_no": 1,
            "description": "Barrel rotation carries cylinder bores into communication with inlet and outlet passages through the port plate."
          },
          {
            "step_no": 2,
            "description": "Pistons slide in bores as their shoes follow the secondary member, receiving and discharging fluid."
          }
        ]
      },
      {
        "action_id": "ACT_MODULATE_TRANSITION",
        "name": "Adjust pressure transition using secondary member",
        "owner": "secondary_swashplate",
        "steps": [
          {
            "step_no": 1,
            "description": "Inlet/outlet differential pressure and primary-member angular position inform the desired secondary-member position."
          },
          {
            "step_no": 2,
            "description": "The secondary member pivots in the second arcuate direction to control pressure transitions as bores pass trapped-volume regions."
          }
        ]
      },
      {
        "action_id": "ACT_TRANSMIT_MOTION",
        "name": "Transmit actuator motion through link",
        "owner": "actuating_mechanism",
        "steps": [
          {
            "step_no": 1,
            "description": "Remote actuator output acts through a force member on a link in the primary member."
          },
          {
            "step_no": 2,
            "description": "The link engages a reaction member in the secondary-member slot and moves the secondary member."
          }
        ]
      }
    ]
  }
