      "req_id": "contact_angle",
      "category": "design_constraint",
      "priority": "high",
      "statement": "Set the contact angle between a ball and one or both screw grooves within about 20–40 degrees.",
      "rationale": "Claim 1; disclosed as promoting more uniform ball loading and reduced contact pressure under compound loading.",
      "satisfied_by": [
        "shaft",
        "nut",
        "balls"
      ]
    },
    {
      "req_id": "ball_diameter",
      "category": "design_constraint",
      "priority": "medium",
      "statement": "In the dependent-claim embodiment, each ball outer diameter is 75–110% of ball-screw lead.",
      "rationale": "Dependent claim 2.",
      "satisfied_by": [
        "balls"
      ]
    },
    {
      "req_id": "groove_depth",
      "category": "design_constraint",
