        "action_id": "ACTUATE_LIFT",
        "name": "Translate trolley and actuate lift",
        "owner": "DRIVE",
        "steps": [
          {
            "step_no": 1,
            "description": "Turning means rotate the helically threaded shaft in a selected direction."
          },
          {
            "step_no": 2,
            "description": "Thread engagement drives or draws the trolley longitudinally along the chassis tracks."
          },
          {
            "step_no": 3,
            "description": "Trolley travel flexes or extends the scissor arm matrix, raising or lowering the platform."
