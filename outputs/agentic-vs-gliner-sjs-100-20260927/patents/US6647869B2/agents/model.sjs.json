      "flow_id": "shaft_rotation",
      "name": "Crankshaft rotation",
      "flow_type": "mechanical_rotary",
      "notes": "Crankshaft/second-eccentric rotation at the bushing interface during adjustment changes eccentric position and stroke length."
    },
    {
      "flow_id": "slide_motion",
      "name": "Press-slide reciprocation",
      "flow_type": "mechanical_linear",
      "notes": "Press connection member drives the press slide in reciprocating press operation."
    },
    {
      "flow_id": "bar_motion",
      "name": "Alignment-bar movement",
      "flow_type": "mechanical_linear",
      "notes": "Cylinder moves the bar into or out of the bushing keyway; when engaged, bar and keyway form a selective positive-lock relationship, not continuous motion-through."
    }
  ],
  "requirements": [
    {
      "req_id": "stroke_adjustment",
      "category": "functional",
      "priority": "claim-supported",
      "statement": "When the connecting mechanism is activated, crankshaft rotation shall cause a press stroke adjustment.",
      "rationale": "Supported functional obligation from claim 1.",
      "satisfied_by": [
        "second_eccentric",
        "eccentric_bushing"
      ]
    },
    {
      "req_id": "positive_alignment",
      "category": "functional",
      "priority": "claim-supported",
      "statement": "Claim-derived modeled obligation: the alignment means is selectively actuatable into a positive-lock position with the eccentric bushing during stroke adjustment; that position defines its first movement limit.",
      "rationale": "Claim 1 defines positive-lock position as the first limit of alignment-means movement; claims 8–9 identify the receiving keyway and bar.",
      "satisfied_by": [
        "alignment_bar",
        "eccentric_bushing",
        "press_connection"
      ]
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "adjust_stroke",
        "name": "Adjust Press Stroke",
        "owner": "eccentric_bushing",
        "steps": [
          {
            "step_no": 1,
            "description": "In the disclosed adjustment embodiment, with the press stopped, the bushing keyway is aligned with the bar and the cylinder pushes the bar into the keyway; the lower-limit sensor detects the bar position."
          },
          {
            "step_no": 2,
            "description": "Apply pressure oil at the eccentric-bushing interface to release the fit to the crankshaft eccentric and create a temporary press fit to the press connection member."
          },
          {
            "step_no": 3,
            "description": "Rotate the crankshaft and second eccentric to change their position within the bushing and thereby change the stroke length."
          },
          {
            "step_no": 4,
            "description": "After crankshaft rotation, high-pressure oil is halted, creating clearance between the connection member and eccentric bushing; the cylinder may raise the bar, and the spring holds it up during press operation."
          }
        ]
      }
    ]
  },
