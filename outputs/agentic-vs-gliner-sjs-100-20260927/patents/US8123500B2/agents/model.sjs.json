  "behaviour": {
    "actions": [
      {
        "action_id": "PUMP_STROKE",
        "name": "Reciprocate and displace pumped fluid",
        "owner": "DRIVE",
        "steps": [
          {
            "step_no": 1,
            "description": "Apply pressurized medium alternately to opposite sides of the adjusting piston."
          },
          {
            "step_no": 2,
            "description": "Reciprocate the piston and its rods to actuate the two diaphragms."
          },
          {
            "step_no": 3,
            "description": "As one diaphragm draws fluid through its inlet path, the other displaces fluid through its outlet path; the directions reverse with piston motion."
          }
        ]
      },
      {
        "action_id": "STABILIZE_DIAPHRAGMS",
        "name": "Hydraulically support diaphragm curvature",
        "owner": "REACTION_SPACES",
        "steps": [
          {
            "step_no": 1,
            "description": "Hydraulic fluid occupies the two reaction spaces and their communicating linkage."
          },
          {
            "step_no": 2,
            "description": "The communicating hydraulic linkage follows diaphragm adjustment and supports the diaphragms against folding over."
          }
        ]
      }
    ]
  }
