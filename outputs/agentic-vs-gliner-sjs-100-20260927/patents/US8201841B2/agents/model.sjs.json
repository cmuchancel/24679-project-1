  "item_flows": [
    {
      "flow_id": "compression",
      "name": "Suspension shock compression",
      "flow_type": "mechanical_linear",
      "notes": "Rear wheel articulates generally upward as suspension compresses; no external force magnitude or source is specified."
    },
    {
      "flow_id": "link_rotation",
      "name": "Paired linkage rotation",
      "flow_type": "mechanical_rotational",
      "notes": "First linkage member changes rotational direction over compression travel."
    },
    {
      "flow_id": "rear_path",
      "name": "Rear wheel axle path",
      "flow_type": "mechanical_motion",
      "notes": "Claimed non-arc path relative to the front frame in specified claim formulations."
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "control_rear_motion",
        "name": "Control rear wheel suspension motion",
        "owner": "shock",
        "steps": [
          {
            "step_no": 1,
            "description": "Rear wheel articulates generally upward and compresses the shock absorber between its mounting points, providing resistance to rear-wheel motion."
          },
          {
            "step_no": 2,
            "description": "The linkage members rotate during compression; the first linkage member initially rotates in one direction and subsequently reverses direction."
          },
          {
            "step_no": 3,
            "description": "As compression progresses, chainstay-length change rate as a function of vertical wheel travel initially increases at least through statically loaded sag, then decreases (claim 7); shock rate initially decreases, then increases, then decreases again (claims 12 and 16). Rear-wheel travel is described as a non-arc path relative to the front frame (claims 12, 16, and 17)."
          }
        ]
      }
    ]
  }
