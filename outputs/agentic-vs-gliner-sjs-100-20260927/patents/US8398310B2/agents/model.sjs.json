  "requirements": [
    {
      "req_id": "REQ_ALIGN",
      "category": "performance",
      "priority": "claimed",
      "statement": "Maintain alignment and integrity of bearing unit, seals, and shaft at displacement between the mounting surface and shaft up to 20 degrees.",
      "rationale": "Claim 1 specifies maintenance up to 20 degrees; patent description characterizes exemplary permitted misalignment as greater than 3 degrees and up to 20 degrees.",
      "satisfied_by": [
        "PIVOT",
        "BEARING",
        "SEALS",
        "SLEEVE"
      ]
    },
    {
      "req_id": "REQ_LOCK",
      "category": "functional",
      "priority": "claimed",
      "statement": "Allow the pivot assembly to be locked to the housing to prevent relative movement during operation.",
      "rationale": "Claim 1 expressly requires pivot lockability during operation.",
      "satisfied_by": [
        "HOUSING",
        "PIVOT"
      ]
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "ACT_ALIGN",
        "name": "Accommodate angular misalignment",
        "owner": "PIVOT",
        "steps": [
          {
            "step_no": 1,
            "description": "Pivot assembly moves along the housing's curved interior seat to align the bearing unit, seals, and shaft sleeve with the shaft."
          },
          {
            "step_no": 2,
            "description": "Pivot assembly can be secured to the housing to prevent relative movement during operation."
          }
        ]
      },
      {
        "action_id": "ACT_LUB",
        "name": "Lubricate bearing unit",
        "owner": "PIVOT",
        "steps": [
          {
            "step_no": 1,
            "description": "Pivot assembly holder lubrication port admits lubricant into the bearing unit."
          },
          {
            "step_no": 2,
            "description": "Lubricant passes through the bearing unit to its opposed side, then drains from the pivot assembly through its drain port."
          }
        ]
      }
    ]
  }
