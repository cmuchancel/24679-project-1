            "step_no": 1,
            "description": "Receive pressure, vibration and/or cavitation sensor parameters."
          },
          {
            "step_no": 2,
            "description": "Use pre-established curves or pressure parameter to determine an adjustment."
          },
          {
            "step_no": 3,
            "description": "Command adjustment of variable outlet diameter and/or jet-axis position."
