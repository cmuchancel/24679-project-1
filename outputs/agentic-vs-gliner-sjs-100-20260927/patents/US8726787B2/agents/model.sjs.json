  "behaviour": {
    "actions": [
      {
        "action_id": "drive_clockwise",
        "name": "Drive rotor clockwise",
        "owner": "rotor",
        "steps": [
          {
            "step_no": 1,
            "description": "Pressurize rotor supply port while connecting rotor drain and stator ports to reservoir; fluid travels through base slots and inboard galleries to rotor arm ports, applying pressure to drive clockwise rotation."
          }
        ]
      },
      {
        "action_id": "drive_opposite",
        "name": "Drive rotor in opposite direction",
        "owner": "rotor",
        "steps": [
          {
            "step_no": 1,
            "description": "Pressurize stator port while rotor supply and drain ports are connected to reservoir; fluid pressure in chamber cavities drives the rotor in the opposite direction."
          }
        ]
      },
      {
        "action_id": "bypass_position_limit",
        "name": "Move beyond hydraulic position limit",
        "owner": "port_block",
        "steps": [
          {
            "step_no": 1,
            "description": "At the selected angular position, base slots connect supply and drain paths to form a hydraulic limit during the applicable porting condition."
          },
          {
            "step_no": 2,
            "description": "Simultaneously pressurize rotor supply and drain ports to permit continued rotor motion beyond the selected position."
          }
        ]
      }
