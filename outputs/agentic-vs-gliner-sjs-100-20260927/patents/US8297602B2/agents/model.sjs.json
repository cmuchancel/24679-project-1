  "item_flows": [
    {
      "flow_id": "F_VIB",
      "name": "Input vibration / relative mechanical motion",
      "flow_type": "mechanical_vibration",
      "notes": "Vibration/relative mechanical motion across the isolator mounts between external vibration-generating and vibration-receiving portions through outer cylinder and mounting member; claim allows either assignment to the two mounts."
    },
    {
      "flow_id": "F_FLUID1",
      "name": "Fluid exchange through first restrict passages",
      "flow_type": "hydraulic_fluid",
      "notes": "Fluid flows between each first pressure-receiving chamber and auxiliary chamber; the paths are distinct."
    },
    {
      "flow_id": "F_FLUID2",
      "name": "Fluid exchange through second restrict passage",
      "flow_type": "hydraulic_fluid",
      "notes": "Claim 1's additional branch communicates second pressure-receiving chamber and auxiliary chamber."
    },
    {
      "flow_id": "F_ELASTIC",
      "name": "Elastic mechanical coupling between members",
      "flow_type": "mechanical_elastic",
      "notes": "Internal elastic mechanical coupling through the rubber body between outer cylinder member and mounting member, distinct from external vibration boundary attachments."
    }
