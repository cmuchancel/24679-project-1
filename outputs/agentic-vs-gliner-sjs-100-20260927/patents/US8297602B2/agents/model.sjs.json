  "behaviour": {
    "actions": [
      {
        "action_id": "ACT_DEFORM",
        "name": "Convert vibration deformation to opposed chamber-volume changes",
        "owner": "RUBBER",
        "steps": [
          {
            "step_no": 1,
            "description": "Receive relative vibration-driven motion between outer cylinder and mounting member."
          },
          {
            "step_no": 2,
            "description": "Elastically deform and change the two first pressure-receiving chamber volumes in mutually opposite directions."
          }
        ]
      },
      {
        "action_id": "ACT_FLOW",
        "name": "Exchange fluid through restricted paths",
        "owner": "PAIR",
        "steps": [
          {
            "step_no": 1,
            "description": "Chamber volume and pressure changes drive fluid to-and-fro between each first chamber and the auxiliary chamber through its respective restrict passage."
          },
          {
            "step_no": 2,
            "description": "The diaphragm permits auxiliary chamber volume response; the disclosure states that this helps limit auxiliary pressure rise, allowing smoother flow and suppressing pressure rise in first chambers and dynamic spring-constant rise."
          }
        ]
      }
    ]
  }
