  "item_flows": [
    {
      "flow_id": "F_AXIAL",
      "name": "Axial shaft translation",
      "flow_type": "mechanical_linear",
      "notes": "First pushing member contacts and pushes the shaft, which slides in the clamping case along its axial direction. Elastic-force transfers during the strokes are represented separately by F_RET1 and F_RET2."
    },
    {
      "flow_id": "F_CLAMP",
      "name": "Clamping contact force",
      "flow_type": "mechanical_force",
      "notes": "Clamping arm presses the work toward the pallet."
    },
    {
      "flow_id": "F_RET1",
      "name": "First-stage engagement force",
      "flow_type": "mechanical_force",
      "notes": "First spring force is transmitted through first retainer and engaging member in first stroke."
    },
    {
      "flow_id": "F_RET2",
      "name": "Second-stage engagement force",
      "flow_type": "mechanical_force",
      "notes": "Second spring force is transmitted through second retainer and engaging member in second stroke."
    },
    {
      "flow_id": "F_PUSH2",
      "name": "Second-retainer push",
      "flow_type": "mechanical_linear",
      "notes": "Detached circular protrusion pushes second retainer."
    }
  ],
  "requirements": [
    {
      "req_id": "REQ_RELEASE",
      "category": "functional",
      "priority": "normal",
      "statement": "At the releasing position, neither engaging member engages the shaft, the engaging members remain held in their retainers, and the shaft is detachable from the case.",
      "rationale": "Claim 1; central release behavior stated in the patent.",
      "satisfied_by": [
        "CASE",
        "SHAFT_ARM",
        "STAGE1",
        "STAGE2"
      ]
    },
    {
      "req_id": "REQ_STAGED",
      "category": "functional",
      "priority": "normal",
      "statement": "Transmit first- and second-stage elastic forces to the shaft through their respective retainers during the respective strokes, with the second spring constant larger than the first.",
      "rationale": "Claims 1 and 9 specify the larger second spring constant and staged force transmission.",
      "satisfied_by": [
        "STAGE1",
        "STAGE2",
        "SHAFT_ARM"
      ]
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "ACT_CLAMP",
        "name": "Apply staged clamp",
        "owner": "SHAFT_ARM",
        "steps": [
          {
            "step_no": 1,
            "description": "First stroke moves the clamping arm from maximum separation toward the vicinity of the work, with first-stage elastic force transmitted to the shaft."
          },
          {
            "step_no": 2,
            "description": "At the intermediate third/releasing position neither engaging member engages the shaft, permitting shaft detachment."
          },
          {
            "step_no": 3,
            "description": "Second stroke moves the arm from vicinity of the work to the work, with second-stage elastic force transmitted to the shaft."
          }
        ]
      },
      {
        "action_id": "ACT_GUIDE",
        "name": "Guide shaft pivot and enable removal",
        "owner": "CASE",
        "steps": [
          {
            "step_no": 1,
            "description": "In the optional spiral-groove embodiment, the case guide member follows the shaft groove and permits shaft pivoting during the first stroke."
          },
          {
            "step_no": 2,
            "description": "When the shaft is detached, the guide member can leave the spiral groove."
          }
        ]
      }
    ]
  }
}