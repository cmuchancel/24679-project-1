      "ports": [
        {
          "port_id": "jaw_force_in",
          "name": "Mechanism force input",
          "direction": "in",
          "flow_type": "mechanical_force"
        },
        {
          "port_id": "jaw_grip_out",
          "name": "Workpiece gripping-force output",
          "direction": "out",
          "flow_type": "mechanical_force"
        },
        {
          "port_id": "jaw_baseline_clamp_out",
          "name": "Baseline clamping-force output",
          "direction": "out",
          "flow_type": "mechanical_force"
        }
      ],
      "interfaces": [
        {
          "interface_id": "jaw_to_workpiece",
          "mating_subsystem": "workpiece",
          "port_this": "jaw_grip_out",
          "port_mate": "workpiece_grip_in",
