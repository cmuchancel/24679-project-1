{
  "$schema": "sjs/1.0",
  "model_meta": {
    "system_name": "Force-Multiplying Workpiece Gripper",
    "system_id": "US8905452B2",
    "description": "Conceptual model of a fluid-actuated gripper in which a force-reversing mechanism couples the actuator rod and cylinder to augment jaw gripping force.",
    "version": "1.0",
    "lifecycle_stage": "concept",
    "domain": "Mechanical gripping systems",
    "maturity": "draft",
    "date_modified": "2026-09-27"
  },
  "subsystems": [
    {
      "subsystem_id": "fluid_source",
      "subsystem_name": "Pressurized Fluid Source",
      "description": "External source supplying pressurized fluid to the actuator chamber.",
      "domain": "Fluid power",
      "ports": [
        {
          "port_id": "source_fluid_out",
          "name": "Pressurized fluid outlet",
          "direction": "out",
          "flow_type": "pressurized_fluid"
        }
      ],
      "interfaces": [
        {
          "interface_id": "fluid_source_to_actuator",
          "mating_subsystem": "actuator",
          "port_this": "source_fluid_out",
          "port_mate": "actuator_fluid_in",
          "flow_ref": "pressurized_fluid",
          "interface_type": "pressurized fluid supply"
        }
      ]
    },
    {
      "subsystem_id": "actuator",
      "subsystem_name": "Cylinder-Piston Actuator",
      "description": "Cylinder contains a sliding piston and coupled piston rod; pressure at the head-end chamber extends the piston rod and produces mechanical motion.",
      "domain": "Fluid power",
      "functional_basis": [
        "Convert fluid pressure to linear motion"
      ],
      "ports": [
        {
          "port_id": "actuator_fluid_in",
          "name": "Head-end chamber fluid inlet",
          "direction": "in",
          "flow_type": "pressurized_fluid"
        },
        {
