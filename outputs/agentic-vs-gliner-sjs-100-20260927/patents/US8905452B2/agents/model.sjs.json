          "direction": "out",
          "flow_type": "mechanical_linear"
        }
      ],
      "interfaces": [
        {
          "interface_id": "actuator_to_mechanism",
          "mating_subsystem": "gear_mechanism",
          "port_this": "actuator_motion_out",
          "port_mate": "mechanism_motion_in",
          "flow_ref": "linear_motion",
          "interface_type": "piston-rod mechanical motion"
        }
      ]
    },
    {
      "subsystem_id": "gear_mechanism",
      "subsystem_name": "Rack-and-Pinion Force Reverser",
      "description": "Embodiment with a first rack associated with the piston rod and a second rack associated with the cylinder, interconnected by a pinion to transmit oppositely directed force.",
      "domain": "Mechanical transmission",
      "functional_basis": [
        "Reverse force",
        "Augment gripping force"
      ],
      "ports": [
        {
          "port_id": "mechanism_motion_in",
          "name": "Rod-driven motion input",
          "direction": "in",
          "flow_type": "mechanical_linear"
        },
        {
          "port_id": "mechanism_force_out",
          "name": "Force-reversed mechanical output",
          "direction": "out",
          "flow_type": "mechanical_force"
        }
      ],
      "interfaces": [
        {
          "interface_id": "mechanism_to_jaw",
          "mating_subsystem": "jaw_assembly",
          "port_this": "mechanism_force_out",
          "port_mate": "jaw_force_in",
          "flow_ref": "reversed_force",
          "interface_type": "reversed mechanical force transfer"
        }
      ]
    },
    {
      "subsystem_id": "jaw_assembly",
      "subsystem_name": "Jaw Assembly",
      "description": "Jaw assembly applies gripping force to the workpiece; claimed embodiments include a cylinder end face jaw or a jaw coupled to the rod end.",
