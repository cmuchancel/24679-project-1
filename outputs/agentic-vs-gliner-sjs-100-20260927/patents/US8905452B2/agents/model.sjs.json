        },
        {
          "interface_id": "jaw_baseline_clamp_to_workpiece",
          "mating_subsystem": "workpiece",
          "port_this": "jaw_baseline_clamp_out",
          "port_mate": "workpiece_baseline_clamp_in",
          "flow_ref": "baseline_clamping_force",
          "interface_type": "jaw clamping contact"
        }
      ]
    },
    {
      "subsystem_id": "workpiece",
      "subsystem_name": "Workpiece",
      "description": "External object contacted and held by the gripper jaws.",
      "domain": "Workholding",
      "ports": [
        {
          "port_id": "workpiece_grip_in",
          "name": "Jaw contact force input",
          "direction": "in",
          "flow_type": "mechanical_force"
        },
        {
          "port_id": "workpiece_baseline_clamp_in",
          "name": "Baseline jaw clamping-force input",
          "direction": "in",
          "flow_type": "mechanical_force"
        }
      ]
    }
  ],
  "item_flows": [
    {
      "flow_id": "pressurized_fluid",
      "name": "Pressurized fluid",
      "flow_type": "pressurized_fluid",
      "notes": "Fluid supplied to actuator head-end chamber; pneumatic embodiment is expressly disclosed."
    },
    {
      "flow_id": "linear_motion",
      "name": "Piston-rod linear motion",
      "flow_type": "mechanical_linear",
      "notes": "Extension of piston rod drives gripper operation."
    },
    {
      "flow_id": "reversed_force",
      "name": "Re-directed mechanical force",
      "flow_type": "mechanical_force",
      "notes": "Force-reversing mechanism transfers an oppositely directed force between rod-associated rack and cylinder-associated rack."
    },
    {
      "flow_id": "grip_force",
      "name": "Gripping force",
      "flow_type": "mechanical_force",
      "notes": "Jaw force applied to workpiece and augmented by force-multiplying mechanism."
    },
    {
      "flow_id": "baseline_clamping_force",
      "name": "Baseline jaw clamping force",
      "flow_type": "mechanical_force",
      "notes": "Clamping force generated on the workpiece by the jaw assembly during pressurization and piston-rod extension, before the force-multiplying mechanism's additional force cumulatively increases gripping force (claim 16)."
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "actuate_and_grip",
        "name": "Actuate and augment grip",
        "owner": "actuator",
        "steps": [
          {
            "step_no": 1,
            "description": "Pressurized fluid enters the head-end chamber and causes piston and piston-rod extension."
          },
          {
            "step_no": 2,
            "description": "During piston-rod extension, the jaw assembly generates a baseline clamping force on the workpiece."
          },
          {
            "step_no": 3,
            "description": "Rod extension also drives the force-reversing mechanism, which applies an oppositely directed mechanical force to the cylinder-side structure; this additional force is applied to the jaw assembly and cumulatively increases its baseline gripping force on the workpiece."
          }
        ]
      }
    ]
  }
}