  "behaviour": {
    "actions": [
      {
        "action_id": "engage_latch",
        "name": "Engage frame member",
        "owner": "latch",
        "steps": [
          {
            "step_no": 1,
            "description": "Position the claw-shaped clasp to engage the frame member."
          },
          {
            "step_no": 2,
            "description": "Rotate the latching member about its first pivot axis using the lever arm in its extended position."
          }
        ]
      },
      {
        "action_id": "fold_lever",
        "name": "Fold lever after latching",
        "owner": "lever",
        "steps": [
          {
            "step_no": 1,
            "description": "After the latching member is coupled to the frame member, rotate the lever arm about its fold axis."
          },
          {
            "step_no": 2,
            "description": "Secure the lever arm in the folded position."
          }
        ]
      }
    ]
