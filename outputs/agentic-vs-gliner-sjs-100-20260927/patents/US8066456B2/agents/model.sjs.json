{
  "$schema": "sjs/1.0",
  "model_meta": {
    "system_name": "Removable Tool Clamping Device",
    "system_id": "US8066456B2",
    "description": "Inferred concept model of a spring-biased pincer tool clamp and its loosening mechanism.",
    "version": "1.0",
    "lifecycle_stage": "concept",
    "domain": "Machine-tool clamping",
    "maturity": "draft",
    "date_modified": "2026-09-27"
  },
  "subsystems": [
    {
      "subsystem_id": "RECV",
      "subsystem_name": "Receiving Part",
      "description": "Hollow receiving structure houses the pincer elements and closing mechanism and receives a tool or fixture.",
      "domain": "Mechanical"
    },
    {
      "subsystem_id": "PINC",
      "subsystem_name": "Pincer Clamp Assembly",
      "description": "Concentric pincer elements and tension spring grip a tool or tool fixture; washer and shoulder support radial and axial positioning.",
      "domain": "Mechanical",
      "functional_basis": [
        "Grip tool",
        "Draw tool into receiving part"
      ],
      "parts": [
        {
          "part_id": "pinchers",
          "description": "Concentrically arranged pincer elements",
          "quantity": 6
        },
        {
          "part_id": "spring",
          "description": "Annular tension spring biasing pincer rear ends inward",
          "quantity": 1
        },
        {
          "part_id": "washer",
          "description": "Inner split lock washer forcing pincer front ends outward",
          "quantity": 1
        }
      ],
      "ports": [
        {
          "port_id": "tool_grip",
          "name": "Tool grip interface",
          "direction": "inout",
          "flow_type": "mechanical_contact"
        },
        {
          "port_id": "closing_contact",
          "name": "Closing-element contact",
          "direction": "inout",
          "flow_type": "mechanical_contact"
        }
      ],
      "interfaces": [
        {
          "interface_id": "IF_PINC_TOOL",
          "mating_subsystem": "TOOL",
          "port_this": "tool_grip",
          "port_mate": "grip",
          "flow_ref": "grip_force",
          "interface_type": "mechanical_contact"
        }
      ]
    },
    {
      "subsystem_id": "CLOSE",
      "subsystem_name": "Closing Element Assembly",
      "description": "Axially movable bushing with clamping claws and sloped surfaces; spring arrangement biases it forward to hold the pincers clamped.",
      "domain": "Mechanical",
      "functional_basis": [
        "Hold pincers in clamping position",
        "Release pincer elements"
      ],
      "ports": [
        {
          "port_id": "pincer_contact",
          "name": "Pincer contact",
          "direction": "inout",
          "flow_type": "mechanical_contact"
        },
        {
          "port_id": "axial_motion",
          "name": "Axial motion",
          "direction": "in",
          "flow_type": "mechanical_linear"
        }
      ],
      "interfaces": [
        {
          "interface_id": "IF_CLOSE_PINC",
          "mating_subsystem": "PINC",
          "port_this": "pincer_contact",
          "port_mate": "closing_contact",
          "flow_ref": "grip_force",
          "interface_type": "mechanical_contact"
        },
        {
          "interface_id": "IF_LOOSEN_CLOSE",
          "mating_subsystem": "LOOSEN",
          "port_this": "axial_motion",
          "port_mate": "pull_out",
          "flow_ref": "motion_pull",
          "interface_type": "mechanical_linear"
        }
      ]
    },
    {
      "subsystem_id": "LOOSEN",
      "subsystem_name": "Loosening Mechanism",
      "description": "Push rod and cone/ball gear actuate the pull rod to retract the closing element and release the pincer claws.",
      "domain": "Mechanical",
      "functional_basis": [
        "Transmit release actuation",
        "Retract closing element"
      ],
      "ports": [
        {
          "port_id": "pull_out",
          "name": "Pull-rod motion",
          "direction": "out",
          "flow_type": "mechanical_linear"
        }
      ]
    },
    {
      "subsystem_id": "TOOL",
      "subsystem_name": "Tool or Tool Fixture",
      "description": "Removable tool or fixture with tightening bolt engaged by the pincer elements.",
      "domain": "Mechanical",
      "ports": [
        {
          "port_id": "grip",
          "name": "Grip interface",
          "direction": "inout",
          "flow_type": "mechanical_contact"
        }
      ]
    }
  ],
  "item_flows": [
    {
      "flow_id": "motion_pull",
      "name": "Pull rod retraction",
      "flow_type": "mechanical_linear"
    },
    {
      "flow_id": "grip_force",
      "name": "Pincer grip on tool",
      "flow_type": "mechanical_contact"
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "ACT_CLAMP",
        "name": "Clamp tool",
        "owner": "PINC",
        "steps": [
          {
            "step_no": 1,
            "description": "Tension spring biases the pincer elements inward around the tool tightening bolt."
          },
          {
            "step_no": 2,
            "description": "Forward-biased closing element claws engage the pincer working surfaces and hold the pincers in the clamping position."
          }
        ]
      },
      {
        "action_id": "ACT_RELEASE",
        "name": "Disengage closing-element claws",
        "owner": "LOOSEN",
        "steps": [
          {
            "step_no": 1,
            "description": "Push rod movement actuates the loosening gear, which drives the pull rod backward."
          },
          {
            "step_no": 2,
            "description": "Pull rod retracts the closing element against its spring arrangement, disengaging its claws from the pincer elements."
          }
        ]
      }
    ]
  }
}