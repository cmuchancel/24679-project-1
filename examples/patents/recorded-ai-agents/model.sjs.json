      "ports": [
        {
          "port_id": "accessory_mech_in",
          "name": "Mechanical input",
          "direction": "in",
          "flow_type": "mechanical_rotational"
        }
      ]
    }
  ],
  "item_flows": [
    {
      "flow_id": "DRIVE_ROTATION",
      "name": "Drive rotation",
      "flow_type": "mechanical_rotational",
      "notes": "External source drives first gear."
    },
    {
      "flow_id": "MESH_ROTATION",
      "name": "Gear-mesh rotational transfer",
      "flow_type": "mechanical_rotational",
      "notes": "Drive gear tooth contact causes driven gear rotation."
    },
    {
      "flow_id": "PUMPED_FLUID",
      "name": "Pumped fluid",
      "flow_type": "fluid",
      "notes": "Fluid moves from inlet to outlet through spaces between teeth around outer periphery of gears."
    },
    {
      "flow_id": "ACCESSORY_POWER",
      "name": "Mechanical power to accessory",
      "flow_type": "mechanical_rotational",
      "notes": "Power to optional accessory passes through pumping-gear mesh."
    }
  ],
  "behaviour": {
    "actions": [
      {
        "action_id": "ROTATE_AND_PUMP",
        "name": "Rotate gears and pump fluid",
        "owner": "DRIVE_GEAR",
        "steps": [
          {
            "step_no": 1,
            "description": "External drive means rotates the drive gear."
          },
          {
            "step_no": 2,
            "description": "Drive-gear teeth contact the driven-gear contact faces and rotate the driven gear."
          },
          {
            "step_no": 3,
            "description": "Spaces between the teeth move fluid from inlet to outlet around the gears."
          }
        ]
      },
      {
        "action_id": "DRIVE_ACCESSORY",
        "name": "Transfer power to driven-gear accessory",
        "owner": "DRIVEN_GEAR",
        "steps": [
          {
            "step_no": 1,
            "description": "Driven-gear rotation supplies power through the gear mesh to an attached optional component."
          }
        ]
      }
    ]
  },
  "requirements": [
    {
      "req_id": "REQ_TOOTH_COUNT",
      "category": "design",
      "priority": "stated",
      "statement": "The first gear has a greater number of teeth than the second gear.",
      "rationale": "Claim 1; the disclosed embodiment illustrates 16 drive-gear teeth and 13 driven-gear teeth.",
      "satisfied_by": [
        "DRIVE_GEAR",
        "DRIVEN_GEAR"
      ]
    },
    {
      "req_id": "REQ_ASYMMETRIC_TOOTH_FACES_BOTH_GEARS",
      "category": "geometry",
      "priority": "stated",
      "statement": "The teeth on both gears have asymmetric faces relative to the claimed centerline.",
      "rationale": "Claim 1 specifies asymmetric faces on teeth of both gears.",
      "satisfied_by": [
        "DRIVE_GEAR",
        "DRIVEN_GEAR"
      ]
    },
    {
      "req_id": "REQ_DRIVEN_GEAR_TOOTH_GEOMETRY",
      "category": "geometry",
      "priority": "stated",
      "statement": "For the second (driven) gear, the contact face is designed to provide an effectively thicker tooth apex; its contact-face involute has a greater radius of curvature than its non-contact-face involute. Circumferential gaps between adjacent second-gear teeth extend radially inward beyond the non-contact-face curvature circle, while the contact-face curvature circle is radially inward of the gaps' radially innermost portion.",
      "rationale": "Claims 3–6 specify the driven-gear thicker apex, involute curvature relationship, and gap/circle placement.",
      "satisfied_by": [
        "DRIVEN_GEAR"
      ]
    }
  ]
}