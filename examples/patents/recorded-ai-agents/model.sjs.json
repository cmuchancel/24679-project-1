{
  "$schema": "sjs/1.2",
  "model_meta": {
    "system_name": "Unequal-Tooth Gear Pump",
    "system_id": "US8087913B2",
    "description": "Concept model of a gear pump with a higher-tooth-count drive gear meshing with a lower-tooth-count driven gear, moving fluid from inlet to outlet and optionally powering a component on the driven gear.",
    "version": "1.0",
    "lifecycle_stage": "concept",
    "domain": "Fluid machinery",
    "maturity": "draft",
    "date_modified": "2026-10-04"
  },
  "subsystems": [
    {
      "subsystem_id": "PUMP_HOUSING",
      "subsystem_name": "Pump housing",
      "description": "Housing that mounts the drive gear and driven gear; bounds the pump fluid path.",
      "domain": "Mechanical",
      "ports": [
        {
          "port_id": "housing_fluid_in",
          "name": "Pump fluid entry",
          "direction": "in",
          "flow_type": "fluid"
